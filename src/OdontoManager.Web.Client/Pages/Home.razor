@page "/"
@inject ISystemStatusClient SystemStatusClient
@inject TimeProvider TimeProvider

<PageTitle>Início — Odonto Manager</PageTitle>

<RadzenStack Gap="1rem">
    <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">Bem-vindo ao Odonto Manager</RadzenText>
    <RadzenText class="data-de-hoje">Hoje é @_hoje</RadzenText>

    @switch (_status)
    {
        case null:
            <RadzenAlert AlertStyle="AlertStyle.Info" AllowClose="false" Shade="Shade.Lighter" class="status-do-sistema">
                Verificando a disponibilidade do sistema...
            </RadzenAlert>
            break;
        case SystemStatus.Disponivel:
            <RadzenAlert AlertStyle="AlertStyle.Success" AllowClose="false" Shade="Shade.Lighter" class="status-do-sistema">
                Sistema disponível.
            </RadzenAlert>
            break;
        default:
            <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false" Shade="Shade.Lighter" class="status-do-sistema">
                Sistema indisponível no momento. Tente novamente em instantes.
            </RadzenAlert>
            break;
    }
</RadzenStack>

@code {
    private SystemStatus? _status;
    private string _hoje = "";

    protected override async Task OnInitializedAsync()
    {
        _hoje = TimeProvider.GetLocalNow().ToString("D", System.Globalization.CultureInfo.CurrentCulture);
        _status = await SystemStatusClient.ObterAsync(CancellationToken.None);
    }
}
