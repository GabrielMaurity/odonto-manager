@inherits LayoutComponentBase

<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            <RadzenSidebarToggle Click="@AlternarMenu" aria-label="Alternar menu" />
            <RadzenText TextStyle="TextStyle.H5" TagName="TagName.Span" class="rz-m-0 app-nome">Odonto Manager</RadzenText>
        </RadzenStack>
    </RadzenHeader>
    <RadzenSidebar @bind-Expanded="_menuExpandido">
        <NavMenu />
    </RadzenSidebar>
    <RadzenBody>
        <main class="app-conteudo">
            @Body
        </main>
    </RadzenBody>
</RadzenLayout>

<RadzenComponents />

<div id="blazor-error-ui" data-nosnippet>
    Ocorreu um erro inesperado.
    <a href="." class="reload">Recarregar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _menuExpandido = true;

    private void AlternarMenu() => _menuExpandido = !_menuExpandido;
}
